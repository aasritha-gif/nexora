# ─────────────────────────────────────────────────────────────
# NEXORA environment template
# Copy to .env and adjust. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────
NEXORA_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXORA_SECRET_KEY=CHANGE-ME-generate-a-real-secret
NEXORA_ACCESS_TOKEN_MINUTES=30
NEXORA_REFRESH_TOKEN_DAYS=14
NEXORA_CORS_ORIGINS=http://localhost:3000
NEXORA_RATE_LIMIT_REQUESTS=120
NEXORA_RATE_LIMIT_WINDOW_SECONDS=60

# ── Databases (defaults match docker-compose.yml) ──────────
MONGO_USER=nexora
MONGO_PASSWORD=nexora_dev_password
REDIS_PASSWORD=nexora_dev_password
NEO4J_PASSWORD=nexora_dev_password
MONETDB_DATABASE=nexora
MONETDB_USER=nexora
MONETDB_PASSWORD=nexora_dev_password

# Local (non-Docker) connection strings used by the backend
# when running outside docker compose:
NEXORA_MONGO_URL=mongodb://nexora:nexora_dev_password@localhost:27017/?authSource=admin
NEXORA_MONGO_DB=nexora
NEXORA_REDIS_URL=redis://:nexora_dev_password@localhost:6379/0
NEXORA_NEO4J_URI=bolt://localhost:7687
NEXORA_NEO4J_USER=neo4j
NEXORA_NEO4J_PASSWORD=nexora_dev_password
NEXORA_MONETDB_HOST=localhost
NEXORA_MONETDB_PORT=50000
NEXORA_MONETDB_DATABASE=nexora
NEXORA_MONETDB_USER=nexora
NEXORA_MONETDB_PASSWORD=nexora_dev_password

# ── AI provider (abstraction layer — swap via config) ──────
# none   : AI features return an honest "not configured" state
# openai : any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter,
#          Ollama http://localhost:11434/v1, LM Studio, vLLM, ...)
# anthropic : Anthropic Messages API (embeddings unavailable —
#          lexical retrieval used for RAG instead)
NEXORA_AI_PROVIDER=none
NEXORA_AI_API_KEY=
NEXORA_AI_BASE_URL=
NEXORA_AI_MODEL=gpt-4o-mini
NEXORA_AI_EMBEDDING_MODEL=text-embedding-3-small

# ── YouTube Data API v3 (video discovery) ──────────────────
# https://console.cloud.google.com → enable "YouTube Data API v3" → API key
NEXORA_YOUTUBE_API_KEY=

# ── Email (password reset delivery) ────────────────────────
NEXORA_SMTP_HOST=
NEXORA_SMTP_PORT=587
NEXORA_SMTP_USER=
NEXORA_SMTP_PASSWORD=
NEXORA_EMAIL_FROM=NEXORA <no-reply@example.edu>

# ── Payments for PREMIUM resources ─────────────────────────
# none   : purchase flow honestly reports "provider not configured"
# stripe : real Stripe Checkout (test or live keys)
NEXORA_PAYMENT_PROVIDER=none
NEXORA_STRIPE_SECRET_KEY=
NEXORA_STRIPE_WEBHOOK_SECRET=

# ── Ingestion / synchronization ────────────────────────────
NEXORA_SYNC_ENABLED=true
NEXORA_SYNC_INTERVAL_MINUTES=360
# Crossref polite-pool contact address (recommended, not required)
NEXORA_CROSSREF_MAILTO=

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
